# Acceptance-harness image (C79). NOT the release image — the release
# Dockerfile compiles ./cmd/api only and its build context explicitly
# denies cmd/testapp + cmd/fixture. This image carries the test
# binaries the isolated acceptance composition needs:
#   testapp — real API/engine/dispatcher with fixture seams injected
#   fixture — deterministic check target on the public-subnet network
#   admin / channel — operator CLIs for seeding and verification
# The build context is governed by Dockerfile.test.dockerignore.
FROM golang:1.27.3-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN mkdir -p /out && CGO_ENABLED=0 go build -trimpath -o /out/ \
      ./cmd/testapp ./cmd/fixture ./cmd/admin ./cmd/channel

FROM debian:bookworm-slim
RUN useradd --system --uid 10001 --create-home harness
COPY --from=build /out/testapp /out/fixture /out/admin /out/channel /harness-bin/
USER harness
ENTRYPOINT []
CMD ["/harness-bin/testapp"]
