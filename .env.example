# Example environment values — copy to .env and change before use.
# Never commit a real .env; it is gitignored. Values here are placeholders,
# not credentials.

# --- Local PostgreSQL (persistent learning data, named volume) ---
POSTGRES_USER=uptime
POSTGRES_PASSWORD=replace-me-local-password
POSTGRES_DB=uptime
POSTGRES_PORT=5432

# --- Disposable test PostgreSQL (tmpfs, isolated "test" network) ---
TEST_POSTGRES_USER=uptime_test
TEST_POSTGRES_PASSWORD=replace-me-test-password
TEST_POSTGRES_DB=uptime_test
TEST_POSTGRES_PORT=5433

# --- Application DSNs (consumed by the API config in later commits) ---
DATABASE_URL=postgres://uptime:replace-me-local-password@127.0.0.1:5432/uptime?sslmode=disable
TEST_DATABASE_URL=postgres://uptime_test:replace-me-test-password@127.0.0.1:5433/uptime_test?sslmode=disable
