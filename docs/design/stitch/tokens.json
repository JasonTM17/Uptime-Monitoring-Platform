{
  "$comment": "Semantic design tokens for the uptime console — named by purpose, not hex. Derived from Stitch 'Obsidian Telemetry' (assets/9dd72099cc3446508e235352a94e0a4f) with deliberate additions marked. these map to Tailwind theme values; do not copy generated HTML.",
  "meta": {
    "source": "stitch project 6396467794726005194 / design system Obsidian Telemetry",
    "concept": true,
    "themes": ["dark", "light"],
    "primary_theme": "dark"
  },
  "color": {
    "bg": {
      "canvas": { "dark": "#031427", "light": "#f8fafc" },
      "container": { "dark": "#102034", "light": "#ffffff" },
      "overlay": { "dark": "#1b2b3f", "light": "#f1f5f9" },
      "inset": { "dark": "#000f21", "light": "#f1f5f9" }
    },
    "fg": {
      "primary": { "dark": "#d3e4fe", "light": "#0f172a" },
      "secondary": { "dark": "#bec8d2", "light": "#334155" },
      "muted": { "dark": "#88929b", "light": "#64748b" },
      "inverse": { "dark": "#213145", "light": "#d3e4fe" }
    },
    "border": {
      "default": { "dark": "#1e293b", "light": "#e2e8f0" },
      "strong": { "dark": "#3e4850", "light": "#cbd5e1" },
      "subtle": { "dark": "#0b1c30", "light": "#f1f5f9" }
    },
    "accent": {
      "default": { "dark": "#0ea5e9", "light": "#0369a1" },
      "hover": { "dark": "#38bdf8", "light": "#075985" },
      "fg": { "dark": "#00344d", "light": "#ffffff" },
      "subtle": { "dark": "#0b2a3d", "light": "#e0f2fe" },
      "$note": "light accent darkened from #0284c7 to #0369a1 for AA (5.93)"
    },
    "status": {
      "up": {
        "fg": { "dark": "#4edea3", "light": "#047857" },
        "bg": { "dark": "#0f2b21", "light": "#d1fae5" },
        "border": { "dark": "#10b98133", "light": "#a7f3d0" },
        "dot": { "dark": "#10b981", "light": "#047857" }
      },
      "down": {
        "fg": { "dark": "#ffb4ab", "light": "#be123c" },
        "bg": { "dark": "#2d1215", "light": "#ffe4e6" },
        "border": { "dark": "#f43f5e66", "light": "#fda4af" },
        "strong": { "dark": "#fb7185", "light": "#be123c" },
        "$note": "strong reserved for fills/large text only — #f43f5e is AA-lg (4.47) not AA on containers"
      },
      "paused": {
        "fg": { "dark": "#94a3b8", "light": "#64748b" },
        "bg": { "dark": "#1b2430", "light": "#f1f5f9" },
        "border": { "dark": "#64748b4d", "light": "#cbd5e1" }
      },
      "stale": {
        "fg": { "dark": "#fbbf24", "light": "#b45309" },
        "bg": { "dark": "#2b2113", "light": "#fef3c7" },
        "border": { "dark": "#fbbf2440", "light": "#fcd34d" },
        "$note": "deliberate addition — not in Stitch palette; stale ≠ error ≠ healthy"
      },
      "absent": {
        "fg": { "dark": "#94a3b8", "light": "#64748b" },
        "bg": { "dark": "#1b2430", "light": "#f1f5f9" },
        "border": { "dark": "#64748b4d", "light": "#cbd5e1" },
        "$note": "missing evidence — distinct from zero, never green"
      }
    },
    "chart": {
      "ok": { "dark": "#4edea3", "light": "#047857" },
      "degraded": { "dark": "#fbbf24", "light": "#b45309" },
      "outage": { "dark": "#fb7185", "light": "#be123c" },
      "nodata": { "dark": "#3e4850", "light": "#cbd5e1" },
      "series": { "dark": "#38bdf8", "light": "#0369a1" },
      "seriesSecondary": { "dark": "#a78bfa", "light": "#6d28d9" },
      "grid": { "dark": "#1e293b", "light": "#e2e8f0" },
      "axis": { "dark": "#64748b", "light": "#64748b" }
    },
    "focus": {
      "ring": { "dark": "#0ea5e9", "light": "#0369a1" },
      "offset": { "dark": "#031427", "light": "#f8fafc" },
      "style": "2px solid ring + 2px offset; never outline:none without replacement"
    },
    "error": {
      "fg": { "dark": "#ffb4ab", "light": "#be123c" },
      "bg": { "dark": "#2d1215", "light": "#ffe4e6" },
      "border": { "dark": "#f43f5e66", "light": "#fda4af" }
    },
    "denied": {
      "fg": { "dark": "#fbbf24", "light": "#b45309" },
      "bg": { "dark": "#2b2113", "light": "#fef3c7" },
      "border": { "dark": "#fbbf2440", "light": "#fcd34d" },
      "$note": "denied is not error — capability absence is an amber informational state"
    },
    "disabled": {
      "fg": { "dark": "#3e4850", "light": "#94a3b8" },
      "bg": { "dark": "#102034", "light": "#f1f5f9" },
      "border": { "dark": "#1e293b", "light": "#e2e8f0" },
      "$note": "disabled = can't act now (offline/cooldown) vs denied = may never act"
    }
  },
  "font": {
    "sans": "Inter",
    "mono": "JetBrains Mono",
    "scale": {
      "xs": { "size": "11px", "line": "14px", "family": "mono", "use": "timestamps, codes, request ids" },
      "sm": { "size": "12px", "line": "16px", "family": "sans", "use": "secondary text, table cells" },
      "base": { "size": "13px", "line": "18px", "family": "sans", "use": "body" },
      "md": { "size": "14px", "line": "20px", "family": "sans", "weight": 600, "use": "section heads" },
      "lg": { "size": "18px", "line": "24px", "family": "sans", "weight": 600, "use": "card titles" },
      "xl": { "size": "24px", "line": "32px", "family": "sans", "weight": 600, "use": "page titles" },
      "metric": { "size": "20px", "line": "24px", "family": "mono", "weight": 500, "use": "primary numerals" },
      "metricSm": { "size": "12px", "line": "16px", "family": "mono", "weight": 500, "use": "inline metrics" },
      "caps": { "size": "10px", "line": "12px", "family": "mono", "weight": 600, "letterSpacing": "0.08em", "use": "labels, badges, table heads" }
    }
  },
  "space": {
    "unit": "4px",
    "scale": { "1": "0.25rem", "2": "0.375rem", "3": "0.5rem", "4": "0.75rem", "5": "1rem" },
    "gutter": "0.75rem",
    "pageMargin": "1rem",
    "$note": "dense telemetry rhythm — max 16px; nothing larger inside data surfaces"
  },
  "radius": { "sm": "0.125rem", "md": "0.25rem", "lg": "0.375rem", "xl": "0.5rem", "pill": "9999px" },
  "shadow": {
    "overlay": "0 0 0 1px #374151, 0 8px 16px -4px rgba(0,0,0,0.65)",
    "none": "no ambient shadows on data surfaces — depth comes from border+tonal step"
  },
  "motion": {
    "duration": { "fast": "80ms", "normal": "140ms" },
    "reducedMotion": "spinners/skeletons degrade to static 'loading' text; charts render without animation; live-pulse dots become static dots"
  },
  "component": {
    "badge": { "height": "18px", "padding": "0 6px", "font": "caps", "states": "up|down|paused|stale|absent — icon+label, never color-only" },
    "freshnessChip": { "states": "fresh (muted) | stale (status.stale) | absent (status.absent)", "rule": "every data surface shows data age; stale is never green" },
    "button": {
      "primary": { "height": "32px", "padding": "0 12px", "bg": "accent.default", "fg": "accent.fg" },
      "ghost": { "bg": "bg.container", "border": "border.default", "fg": "fg.primary" },
      "destructive": { "bg": "transparent", "border": "status.down.border", "fg": "status.down.strong", "rule": "always icon+label or label-only — never icon-only" },
      "states": "default | hover | focus-visible (ring) | disabled | denied"
    },
    "input": { "height": "28px", "bg": "bg.inset", "border": "border.default", "focusBorder": "accent.default", "mono": "URLs, request IDs, version fields" },
    "table": { "rowHeight": "36px", "headerBg": "bg.canvas", "headerFont": "caps", "numericAlign": "right + mono + tabular" },
    "card": { "bg": "bg.container", "border": "border.default", "padding": "8px 12px" },
    "dialog": { "bg": "bg.overlay", "border": "border.strong", "shadow": "shadow.overlay", "focus": "trapped; Escape closes; labelled-by title" }
  },
  "a11y": {
    "contrastReceipt": {
      "checked": "2025-10-22",
      "rule": "WCAG AA — text ≥4.5, large/UI ≥3.0",
      "dark": "all pairs AA; status.down.strong #f43f5e is AA-lg 4.47 → restricted to fills/large text",
      "light": "all pairs AA after accent darkened to #0369a1 (5.93) and status.down to #be123c (6.01)",
      "method": "relative-luminance computation per pair; results recorded in design-decisions.md"
    },
    "nonColorSignal": "every status carries icon+label or shape+label; charts always paired with table alternative",
    "minTarget": "28px interactive height on dense surfaces; 44px on primary flows"
  }
}
